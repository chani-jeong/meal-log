rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validMeal(d) {
      return d.keys().hasAll(['date', 'mealType', 'name', 'amount', 'nutrients'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.mealType in ['breakfast', 'lunch', 'dinner', 'snack']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 50
        && d.amount is number && d.amount >= 1 && d.amount <= 2000
        && d.nutrients is map;
    }

    // 식사 기록: 본인만 읽기·쓰기, 저장 형식 검사
    match /users/{uid}/meals/{mealId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validMeal(request.resource.data);
    }

    // 사용자 설정(목표 칼로리 등): 본인만 읽기·쓰기
    match /users/{uid}/settings/{settingId} {
      allow read, write: if isOwner(uid);
    }
  }
}
